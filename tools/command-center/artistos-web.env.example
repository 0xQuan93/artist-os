# Placeholder-only ArtistOS website environment.
# Copy values into the deployment platform's server-side secret manager.
# Never commit a populated environment file.

ARTISTOS_BIND_HOST=0.0.0.0
ARTISTOS_PUBLIC_ORIGIN=https://artistos.example.com
ARTISTOS_ACCESS_PASSCODE=replace-with-a-long-random-passcode

# Keep this private behind the trusted TLS reverse proxy.
PORT=8989

# Optional private workspace override. Replace with an absolute server path.
ARTISTOS_WORKSPACE_ROOT=/replace/with/private/artistos-workspace
