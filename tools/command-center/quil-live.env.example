# QUIL LIVE is disabled unless this exact opt-in is set.
ARTISTOS_ENABLE_QUIL_LIVE=1

# Use a unique random secret of at least 32 characters. Never commit a real token.
ARTISTOS_QUIL_LIVE_TOKEN=replace-with-a-private-random-token-at-least-32-characters

# Optional bounded controls.
ARTISTOS_QUIL_LIVE_MAX_AGE_SECONDS=300
ARTISTOS_QUIL_LIVE_MAX_EVENTS_PER_MINUTE=120
